# Copy this file to .env and fill in real values. Never commit .env to Git.

# Server
PORT=8000
# Bind address. Defaults to 127.0.0.1 so the service is only reachable
# from the host. Set to 0.0.0.0 only inside an isolated Docker network.
HOST=127.0.0.1
FLASK_DEBUG=false

# Shared secret that must match backend INTERNAL_API_SECRET. When set,
# every request must include X-Internal-Secret or it is rejected with 401.
INTERNAL_API_SECRET=

# Upload directory (relative to this service's working directory)
UPLOAD_DIR=uploads

# Max upload size in MB
MAX_FILE_MB=16
